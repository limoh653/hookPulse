{
  "name": "hookpulse-backend",
  "version": "1.0.0",
  "description": "HookPulse - High-throughput Webhook-as-a-Service (WaaS) Gateway Backend",
  "author": "Hesbon Kipruto Limo",
  "private": true,
  "_documentation": {
    "purpose": "Manages core backend dependencies, lifecycle scripts, and execution entry points for HookPulse.",
    "responsibilities": [
      "Declare production dependencies (NestJS, BullMQ, ioredis, Drizzle ORM, pg, undici, zod, socket.io).",
      "Declare development tooling (TypeScript, Jest, Drizzle-Kit, ts-node).",
      "Define standard build, start, test, and database migration commands."
    ],
    "why_it_exists": "Node.js package manifest providing deterministic, reproducible package resolution across containerized and local developer environments.",
    "interactions": [
      "Consumed by npm/pnpm during docker build or local setup.",
      "Defines runtime scripts called by docker-compose and CI/CD pipelines.",
      "Configures module aliases and testing suites linked with tsconfig.json."
    ],
    "implementation_notes": "Separates the API Ingestion HTTP server and background BullMQ Worker processes into distinct script targets (npm run start:dev vs npm run start:worker)."
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker.main",
    "start:worker:dev": "ts-node -r tsconfig-paths/register src/worker.main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "ts-node -r tsconfig-paths/register src/infrastructure/database/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.8",
    "@nestjs/core": "^10.3.8",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/websockets": "^10.3.8",
    "@nestjs/platform-socket.io": "^10.3.8",
    "bullmq": "^5.7.1",
    "ioredis": "^5.4.1",
    "drizzle-orm": "^0.30.10",
    "pg": "^8.11.5",
    "undici": "^6.18.2",
    "zod": "^3.23.8",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "socket.io": "^4.7.5",
    "ipaddr.js": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.21.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@domain/(.*)$": "<rootDir>/domain/$1",
      "^@application/(.*)$": "<rootDir>/application/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@interfaces/(.*)$": "<rootDir>/interfaces/$1",
      "^@common/(.*)$": "<rootDir>/common/$1"
    }
  }
}
